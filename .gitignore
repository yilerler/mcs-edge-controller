cat << 'EOF' > ~/mcs-edge-controller/.gitignore
# ==========================================
# V5.2 MCS Edge Controller - Git Ignore List
# ==========================================

# 1. 🛡️ Linux Kernel Module 編譯垃圾
ot_defense_layer/src/*.o
ot_defense_layer/src/*.ko
ot_defense_layer/src/*.mod
ot_defense_layer/src/*.mod.c
ot_defense_layer/src/*.mod.o
ot_defense_layer/src/.*.cmd
ot_defense_layer/modules.order
ot_defense_layer/Module.symvers
ot_defense_layer/.*.cmd

# 2. 🌐 ROS 2 工作區編譯垃圾
it_edge_layer/ros2_ws/build/
it_edge_layer/ros2_ws/install/
it_edge_layer/ros2_ws/log/

# 3. 🐍 Python, 編輯器與系統快取
__pycache__/
*.py[cod]
*$py.class
.DS_Store
.vscode/

# 4. 🔑 機密檔案與憑證
secrets/
*.json
serviceAccountKey.json

# 5. 🗑️ 測試或過期資料夾
# mock_client/

# 6. 🖥 OS generated files
   .DS_Store
   .DS_Store?
   ._*
   .Spotlight-V100
   .Trashes
   ehthumbs.db
   Thumbs.db
   __MACOSX/
EOF